# Muestra los accesos de demostración en el login. Solo está activo en desarrollo.
VITE_DEMO_MODE=false

# URL de la API. Vacía en desarrollo: Vite reenvía /api a http://localhost:8000
# (cámbialo con la variable API_PROXY al iniciar `npm run dev`).
VITE_API_URL=

# Responde con los datos simulados de src/mocks/ en lugar de llamar a la API.
VITE_API_MOCK=false

# Con VITE_API_MOCK=true, hace fallar todas las llamadas para probar los estados de error.
VITE_MOCK_FAILURE=false
