# Copia este archivo como .env y ajusta los valores. El .env no se sube al repositorio.

# development, test o production
APP_ENV=development

# Conexión a PostgreSQL. Con back/compose.yaml el usuario y la contraseña son "tickets".
DATABASE_URL=postgresql://tickets:tickets@localhost:5432/tickets
TEST_DATABASE_URL=postgresql://tickets:tickets@localhost:5432/tickets_test

# Zona horaria de la mesa de ayuda: la API muestra las fechas en esta hora local.
TIMEZONE=America/Mexico_City

# Carpeta del dataset y del modelo. Por omisión, back/datos/.
# DATA_DIR=
# MODEL_PATH=

# Orígenes que pueden llamar a la API, en formato JSON.
CORS_ORIGINS=["http://localhost:5173"]

# Clave para firmar las sesiones, de al menos 32 caracteres. Genera una propia con:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=
# Horas que dura una sesión.
SESSION_HOURS=8
